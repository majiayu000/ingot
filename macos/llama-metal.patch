+std::vector<std::pair<size_t, size_t>> llama_model_loader::get_mapping_ranges(
+        int idx, ggml_context * ctx, size_t alignment) const {
+    std::vector<std::pair<size_t, size_t>> ranges;
+    for (auto * t = ggml_get_first_tensor(ctx); t; t = ggml_get_next_tensor(ctx, t)) {
+        const auto * w = get_weight(t->name);
+        if (w && w->idx == idx) {
+            ranges.emplace_back(w->offs, w->offs + ggml_nbytes(t));
+        }
+    }
+    std::sort(ranges.begin(), ranges.end());
+    size_t n = 0;
+    for (const auto & range : ranges) {
+        // Merge overlapping/adjacent native pages, without registering interior expert gaps.
+        if (n && range.first / alignment <= (ranges[n - 1].second + alignment - 1) / alignment) {
+            ranges[n - 1].second = std::max(ranges[n - 1].second, range.second);
+        } else {
+            ranges[n++] = range;
+        }
+    }
+    ranges.resize(n);
+    return ranges;
+}
