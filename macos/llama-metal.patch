+static enum ggml_status ggml_backend_sched_stream_expert(
+        ggml_backend_sched_t sched, ggml_backend_sched_expert_pool & ep,
+        ggml_tensor * node, ggml_backend_t backend) {
+#ifdef __APPLE__
+    GGML_ASSERT(backend == ep.backend);
+    const auto * routing = node->src[2];
+    const int64_t top_k = routing->ne[0];
+    const int64_t n_tokens = routing->ne[1];
+    const int64_t n_routes = top_k * n_tokens;
+    const int64_t n_in = node->src[1]->ne[0];
+    const int64_t n_out = node->ne[0];
+    // Routing is strided in the real model; retain that stride for readback.
+    std::vector<int32_t> raw(ggml_nbytes(routing) / sizeof(int32_t));
+    ggml_backend_tensor_get(routing, raw.data(), 0, ggml_nbytes(routing));
+    std::vector<std::vector<int32_t>> positions(ep.n_expert);
+    for (int64_t t = 0; t < n_tokens; ++t) {
+        for (int64_t rank = 0; rank < top_k; ++rank) {
+            const int32_t e = raw[t * routing->nb[1] / sizeof(int32_t) + rank * routing->nb[0] / sizeof(int32_t)];
+            GGML_ASSERT(e >= 0 && e < ep.n_expert);
+            positions[e].push_back((int32_t) (t * top_k + rank));
+        }
+    }
+    std::vector<int32_t> cached, missing;
+    for (int e = 0; e < ep.n_expert; ++e) {
+        if (!positions[e].empty()) {
+            (ep.expert_slot[e] >= 0 ? cached : missing).push_back(e);
+        }
+    }
+    if (sched->expert_stream_alloc == nullptr) {
+        sched->expert_stream_alloc = ggml_gallocr_new(ggml_backend_get_default_buffer_type(backend));
+    }
+    for (auto * list : {&cached, &missing}) {
+        for (size_t first = 0; first < list->size(); first += ep.n_slots) {
+            std::vector<int32_t> experts(list->begin() + first,
+                    list->begin() + std::min(first + (size_t) ep.n_slots, list->size()));
+            std::vector<int32_t> output_rows, input_rows, slot_ids;
+            for (const int32_t e : experts) {
+                for (const int32_t pos : positions[e]) {
+                    output_rows.push_back(pos);
+                    input_rows.push_back((pos / top_k) * node->src[1]->ne[1] +
+                            (pos % top_k) % node->src[1]->ne[1]);
+                }
+            }
+            const size_t chunks = (output_rows.size() + 30) / 31;
+            const size_t capacity = 64 + 8 * chunks;
+            ggml_init_params params = { ggml_graph_overhead_custom(capacity, false) +
+                    capacity * ggml_tensor_overhead(), nullptr, true };
+            ggml_context * ctx = ggml_init(params);
+            if (ctx == nullptr) {
+                return GGML_STATUS_ALLOC_FAILED;
+            }
+            auto * host_ids = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, 1, experts.size());
+            ggml_backend_buffer_t host_buffer = ggml_backend_buft_alloc_buffer(
+                    ggml_backend_get_default_buffer_type(sched->backends[sched->n_backends - 1]),
+                    ggml_nbytes(host_ids));
+            if (host_buffer == nullptr) {
+                ggml_free(ctx);
+                return GGML_STATUS_ALLOC_FAILED;
+            }
+            host_ids->buffer = host_buffer;
+            host_ids->data = ggml_backend_buffer_get_base(host_buffer);
+            ggml_backend_tensor_set(host_ids, experts.data(), 0, ggml_nbytes(host_ids));
+            ep.updated = false;
+            sched->expert_ids_tensor = nullptr;
+            const bool loaded = ggml_backend_sched_update_expert_pool(sched, ep, host_ids,
+                    sched->backends[sched->n_backends - 1]);
+            sched->expert_ids_tensor = nullptr;
+            ggml_backend_buffer_free(host_buffer);
+            if (!loaded) {
+                ggml_free(ctx);
+                return GGML_STATUS_FAILED;
+            }
+            for (const int32_t e : experts) {
+                for (size_t i = 0; i < positions[e].size(); ++i) {
+                    slot_ids.push_back(ep.expert_slot[e]);
+                }
+            }
+            // Aliases are graph leaves: their producers have already completed in
+            // the parent graph, and must not be recursively executed here.
+            auto * input = ggml_dup_tensor(ctx, node->src[1]);
+            memcpy(input->nb, node->src[1]->nb, sizeof(input->nb));
+            input->data = node->src[1]->data;
+            input->buffer = node->src[1]->buffer;
+            auto * contiguous = ggml_is_contiguous(input) ? input : ggml_cont(ctx, input);
+            auto * flat = ggml_reshape_2d(ctx, contiguous, n_in, node->src[1]->ne[1] * n_tokens);
+            auto * target = ggml_new_tensor_2d(ctx, GGML_TYPE_F32, n_out, n_routes);
+            target->data = node->data;
+            target->buffer = node->buffer;
+            auto * gather_rows = ggml_new_tensor_1d(ctx, GGML_TYPE_I32, input_rows.size());
+            auto * scatter_rows = ggml_new_tensor_1d(ctx, GGML_TYPE_I32, output_rows.size());
+            auto * ids = ggml_new_tensor_2d(ctx, GGML_TYPE_I32, 1, slot_ids.size());
+            ggml_set_input(gather_rows);
+            ggml_set_input(scatter_rows);
+            ggml_set_input(ids);
+            auto * gathered = ggml_reshape_3d(ctx, ggml_get_rows(ctx, flat, gather_rows), n_in, 1, input_rows.size());
+            auto * graph = ggml_new_graph_custom(ctx, capacity, false);
+            for (size_t begin = 0; begin < output_rows.size(); begin += 31) {
+                const int64_t count = std::min<size_t>(31, output_rows.size() - begin);
+                auto * x = ggml_view_3d(ctx, gathered, n_in, 1, count,
+                        gathered->nb[1], gathered->nb[2], begin * n_in * sizeof(float));
+                auto * selected = ggml_view_2d(ctx, ids, 1, count, ids->nb[1], begin * sizeof(int32_t));
+                auto * result = ggml_mul_mat_id(ctx, ep.pool, x, selected);
+                auto * rows = ggml_view_1d(ctx, scatter_rows, count, begin * sizeof(int32_t));
+                auto * scatter = ggml_set_rows(ctx, target, ggml_reshape_2d(ctx, result, n_out, count), rows);
+                ggml_build_forward_expand(graph, scatter);
+            }
+            if (!ggml_gallocr_alloc_graph(sched->expert_stream_alloc, graph)) {
+                ggml_free(ctx);
+                return GGML_STATUS_ALLOC_FAILED;
+            }
+            sched->expert_stream_peak = std::max(sched->expert_stream_peak,
+                    ggml_gallocr_get_buffer_size(sched->expert_stream_alloc, 0));
+            ggml_backend_tensor_set(gather_rows, input_rows.data(), 0, input_rows.size() * sizeof(int32_t));
+            ggml_backend_tensor_set(scatter_rows, output_rows.data(), 0, output_rows.size() * sizeof(int32_t));
+            ggml_backend_tensor_set(ids, slot_ids.data(), 0, slot_ids.size() * sizeof(int32_t));
+            const auto status = ggml_backend_graph_compute(backend, graph);
+            ggml_free(ctx);
+            if (status != GGML_STATUS_SUCCESS) {
+                return status;
+            }
+        }
+    }
+    ++sched->expert_stream_ops;
+    return GGML_STATUS_SUCCESS;
+#else
+    GGML_UNUSED(sched);
+    GGML_UNUSED(ep);
+    GGML_UNUSED(node);
+    GGML_UNUSED(backend);
+    return GGML_STATUS_FAILED;
+#endif
+}
