+    FOR_UNROLL (short rt = 0; rt < RT; ++rt) {
+        FOR_UNROLL (short t = 0; t < NT; ++t) {
+            acc[rt][t][0] = mc[rt][t].thread_elements()[0];
+            acc[rt][t][1] = mc[rt][t].thread_elements()[1];
+        }
+    }
+
+    mul_mv_mma_store<NT, RT>(acc, args, dst, shmem, tile, tiisg, sgitg);
+}
