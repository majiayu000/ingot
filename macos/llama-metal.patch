+// Preserve ordinary split execution and callbacks; interleave streaming only at
+// nodes whose original global IDs exceed the registered slot capacity.
+static enum ggml_status ggml_backend_sched_compute_expert_graph(
+        ggml_backend_sched_t sched, ggml_backend_t backend, ggml_cgraph * graph) {
+    int begin = 0;
+    for (int j = 0; j < graph->n_nodes; ++j) {
+        auto * ep = ggml_backend_sched_streamed_pool(sched, graph->nodes[j]);
+        if (ep == nullptr) {
+            continue;
+        }
+        if (j > begin) {
+            auto prefix = ggml_graph_view(graph, begin, j);
+            const auto status = ggml_backend_graph_compute_async(backend, &prefix);
+            if (status != GGML_STATUS_SUCCESS) {
+                return status;
+            }
+        }
+        ggml_backend_synchronize(backend);
+        const auto status = ggml_backend_sched_stream_expert(sched, *ep, graph->nodes[j], backend);
+        if (status != GGML_STATUS_SUCCESS) {
+            return status;
+        }
+        begin = j + 1;
+    }
+    if (begin == 0) {
+        return ggml_backend_graph_compute_async(backend, graph);
+    }
+    if (begin < graph->n_nodes) {
+        auto suffix = ggml_graph_view(graph, begin, graph->n_nodes);
+        return ggml_backend_graph_compute_async(backend, &suffix);
+    }
+    return GGML_STATUS_SUCCESS;
+}
 
