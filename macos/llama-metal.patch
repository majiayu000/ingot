+// Measured few-row float MMA, adapted from ggml upstream b9acf13.
+static ggml_metal_pipeline_with_params ggml_metal_mul_mv_mma_pipeline(
+        ggml_metal_library_t lib, const ggml_tensor * op, int nsg, int nt, int rt) {
+    const int ne12 = op->src[1]->ne[2];
+    const int r2 = ne12 / op->src[0]->ne[2];
+    const int r3 = op->src[1]->ne[3] / op->src[0]->ne[3];
+    char base[256];
+    char name[256];
+    snprintf(base, sizeof(base), "kernel_mul_mv_mma_%s_f32_nt%d_rt%d", ggml_type_name(op->src[0]->type), nt, rt);
+    snprintf(name, sizeof(name), "%s_nsg=%d_ne12=%d_r2=%d_r3=%d", base, nsg, ne12, r2, r3);
+    auto res = ggml_metal_library_get_pipeline(lib, name);
+    if (!res.pipeline) {
+        auto cv = ggml_metal_cv_init();
+        ggml_metal_cv_set_int16(cv, nsg,  FC_MUL_MV_MMA + 0);
+        ggml_metal_cv_set_int16(cv, ne12, FC_MUL_MV_MMA + 1);
+        ggml_metal_cv_set_int16(cv, r2,   FC_MUL_MV_MMA + 2);
+        ggml_metal_cv_set_int16(cv, r3,   FC_MUL_MV_MMA + 3);
+        res = ggml_metal_library_compile_pipeline(lib, base, name, cv);
+        ggml_metal_cv_free(cv);
+    }
+    res.nsg = nsg;
