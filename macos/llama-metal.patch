+bool ggml_backend_sched_expert_pool_set_file(ggml_backend_sched_t sched, const ggml_tensor * w, int fd, uint64_t offset) {
+#ifdef __APPLE__
+    for (auto & ep : sched->expert_pools) {
+        if (ep.w != w) {
+            continue;
+        }
+        struct stat st;
+        const uint64_t bytes = ggml_nbytes(w);
+        if (ep.file_fd >= 0 || ep.stamp != 0 || fstat(fd, &st) != 0 || st.st_size < 0 ||
+                offset > (uint64_t) st.st_size || bytes > (uint64_t) st.st_size - offset) {
+            return false;
+        }
+        // get_base alone can be a device-only address; the Metal extension confirms
+        // shared CPU access before any pread writes directly into the pool.
+        const auto dev = ggml_backend_buft_get_device(ggml_backend_buffer_get_type(ep.pool_buf));
+        using get_host_pointer_t = void * (*)(ggml_backend_buffer_t);
+        const auto get_host_pointer = reinterpret_cast<get_host_pointer_t>(ggml_backend_reg_get_proc_address(
+                ggml_backend_dev_backend_reg(dev), "ggml_backend_metal_buffer_get_host_pointer"));
+        if (get_host_pointer == nullptr || get_host_pointer(ep.pool_buf) != ep.pool->data) {
+            return false;
+        }
+        const int owned = fcntl(fd, F_DUPFD_CLOEXEC, 0);
+        if (owned < 0) {
+            return false;
+        }
+        ep.file_fd = owned;
+        ep.file_offset = offset;
+        GGML_LOG_INFO("%s: '%s' uses positional file reads on pool misses\n", __func__, w->name);
+        return true;
+    }
+#else
+    GGML_UNUSED(sched); GGML_UNUSED(w); GGML_UNUSED(fd); GGML_UNUSED(offset);
+#endif
+    return false;
 }
 
